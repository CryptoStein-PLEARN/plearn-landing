# ─────────────────────────────────────────────────────────────────────────────
# PLEARN — environment variables
#
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and never committed.
#
# How to find these values:
#   Supabase dashboard → Project Settings → API
#
# VITE_SUPABASE_URL
#   Your project URL, e.g. https://abcdefghijklm.supabase.co
#
# VITE_SUPABASE_ANON_KEY
#   The "publishable" key (newer Supabase UI) or "anon / public" key
#   (older Supabase UI). Both are the same thing — a public key safe for
#   frontend use. NEVER use the secret / service_role key here.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
